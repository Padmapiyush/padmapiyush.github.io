# Optional AI Service Configuration for TeamForge
# If no API key is provided, TeamForge uses its comprehensive, deterministic local tactical evaluator.
# When an API key is provided, the server-side AI evaluation adapter can be utilized.

GEMINI_API_KEY=your_gemini_api_key_here
# Alternative provider (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Mode settings
NEXT_PUBLIC_APP_ENV=development
